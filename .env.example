# ==============================================================
# ENVIRONMENT VARIABLES TEMPLATE - BASO & MIE AYAM OJOLALI V6
# ==============================================================
# Salin file ini menjadi .env lalu sesuaikan dengan konfigurasi Anda.

# 1. Konfigurasi Database MySQL (Laragon / XAMPP / Production)
DATABASE_URL="mysql://root:@localhost:3306/ojolali_db"

# 2. Keamanan JWT (Gunakan minimal 32 karakter unik untuk production)
JWT_SECRET="super-secret-ojolali-key-2026-min-32-characters"

# 3. Pengaturan Aplikasi Web
NEXT_PUBLIC_APP_NAME="Baso & Mie Ayam Ojolali"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Google Gemini API (Opsional - untuk fallback LLM)
GEMINI_API_KEY=""

# 5. Konfigurasi WhatsApp Gateway (Fonnte API)
# Mode: "production" (kirim WA asli via Fonnte) atau "simulation" (log konsol saja)
WHATSAPP_MODE=production
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN="MASUKKAN_TOKEN_FONNTE_ANDA_DISINI"
WHATSAPP_ADMIN_NUMBER=6289502997292
